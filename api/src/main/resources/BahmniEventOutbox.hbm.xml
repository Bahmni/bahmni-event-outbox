<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="org.bahmni.module.eventoutbox.model">

    <class name="org.bahmni.module.eventoutbox.model.OutboxEvent" table="event_records_queue">

        <id name="id" type="java.lang.Integer" column="id">
            <generator class="native">
                <param name="sequence">event_outbox_seq_id</param>
            </generator>
        </id>

        <property name="uuid" type="java.lang.String" column="uuid" length="40" unique="true" />

        <property name="title" type="java.lang.String" column="title" length="255" />

        <property name="timestamp" type="timestamp" column="timestamp" />

        <property name="uri" type="java.lang.String" column="uri" length="255" />

        <property name="content" type="java.lang.String" column="object" length="1000" />

        <property name="category" type="java.lang.String" column="category" length="255" />

        <property name="tags" type="java.lang.String" column="tags" length="255" />

    </class>

</hibernate-mapping>
